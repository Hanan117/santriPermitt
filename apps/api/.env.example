# Database
# Lokal: isi keduanya dengan URL postgres lokal yang sama.
# Supabase (prod): DATABASE_URL = pooler (port 6543 + ?pgbouncer=true) untuk runtime,
# DIRECT_URL = direct (port 5432) untuk `prisma migrate deploy`.
DATABASE_URL="postgresql://user:password@localhost:5432/santri_permit?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/santri_permit?schema=public"

# App
PORT=3001
NODE_ENV=development

# Auth
JWT_SECRET="change-me-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# CORS — prod: isi dengan domain Vercel FE, mis. "https://santripermit.vercel.app"
WEB_URL="http://localhost:3000"

# Uploads — default: ./public/uploads. Prod (VPS/Docker): set ke path volume,
# mis. UPLOAD_DIR=/data/uploads, agar file tidak hilang saat redeploy.
UPLOAD_DIR=""

# Supabase Storage (opsional, tahap berikutnya — biarkan kosong selama pakai disk)
STORAGE_DRIVER="disk"
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="uploads"
