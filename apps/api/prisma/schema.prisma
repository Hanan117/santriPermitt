// SantriPermit - Prisma Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Railway runtime bisa OpenSSL 1.1.x atau 3.0.x tergantung base image —
  // unduh kedua engine agar Query Engine selalu ketemu.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: DATABASE_URL = pooler (6543, ?pgbouncer=true) untuk runtime,
  // DIRECT_URL = direct (5432) untuk migrate. Lokal: isi keduanya sama.
  directUrl = env("DIRECT_URL")
}

// ── Enums ──
enum Role {
  SANTRI
  WALI
  ADMIN
}

enum JenisIzin {
  KELUAR
  PULANG
}

enum StatusIzin {
  MENUNGGU
  DISETUJUI
  DITOLAK
  SEDANG_KELUAR
  SUDAH_KEMBALI
}

// ── Models ──
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(SANTRI)
  santriId  String?
  santri    Santri?  @relation(fields: [santriId], references: [id])
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([santriId])
}

model Santri {
  id        String   @id @default(cuid())
  nis       String   @unique
  nama      String
  kelas     String
  kamar     String
  foto      String?
  alamat    String?
  noHp      String?
  users     User[]
  permissions Permission[]
  waliLinks WaliSantri[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([nama])
  @@index([kelas])
}

model Permission {
  id              String      @id @default(cuid())
  santriId        String
  santri          Santri      @relation(fields: [santriId], references: [id], onDelete: Cascade)

  jenisIzin       JenisIzin
  tujuan          String
  alasan          String      @db.Text
  keterangan      String?     @db.Text

  tanggalKeluar   DateTime    @db.Date
  jamKeluar       String      // "08:00"
  tanggalKembali  DateTime    @db.Date
  jamKembali      String      // "17:00"

  status          StatusIzin  @default(MENUNGGU)
  rejectionReason String?     @db.Text

  approvedById    String?
  approvedAt      DateTime?
  checkedOutAt    DateTime?
  checkedInAt     DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([santriId])
  @@index([status])
  @@index([jenisIzin])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String?  // "approval", "rejection", "reminder", "new_request"
  relatedId String?  // permission id
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model WaliSantri {
  santriId   String
  waliUserId String
  hubungan   String   @default("Wali")
  createdAt  DateTime @default(now())
  santri     Santri   @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@id([santriId, waliUserId])
  @@index([waliUserId])
}

model SystemRule {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  nama      String
  email     String?
  pesan     String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
